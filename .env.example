# ── Development (local) ─────────────────────────────────────────────
# Alfa API — same host as Swagger, without /swagger/index.html
ALFA_API_URL=https://localhost:7211

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret-at-least-32-chars

# ── Production (Vercel) ─────────────────────────────────────────────
# ALFA_API_URL=https://apipharm.aghapy-company.com
# NEXTAUTH_SECRET=generate-a-random-string-at-least-32-characters-long
# NEXTAUTH_URL is optional on Vercel — auto-set from VERCEL_URL
# For a custom domain, set NEXTAUTH_URL=https://your-domain.com
